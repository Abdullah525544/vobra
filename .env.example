# DELISOGA — Environment Configuration
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in your Firebase keys.
# Until you do, the site runs in DEMO MODE using localStorage so
# you can develop & preview everything without a Firebase project.
# ------------------------------------------------------------

# Public Firebase config (safe to expose)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the default "demo" mode by setting to "live"
VITE_DATA_MODE=demo

# Optional: site origin used in canonical/OG tags
VITE_SITE_URL=https://delisoga.com
